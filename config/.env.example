DB2_HOST=your_db2_host
DB2_PORT=50000
DB2_DATABASE=YOURDB
DB2_USER=your_username
DB2_PASSWORD=your_password

# Optional (ADR 0036) - only needed if db2mcp.dynatrace.enabled=true. Blank
# is the correct default; leave unset unless you have a real Dynatrace
# tenant and API token to export to.
DYNATRACE_ENVIRONMENT_URL=
DYNATRACE_API_TOKEN=

# Optional (ADR 0037) - HTTP transport prototype, thread 6. Blank/false is
# the correct default; stdio (ADR 0001) remains the server's default
# transport. Both DB2MCP_HTTP_ENABLED and DB2MCP_HTTP_WEB_APPLICATION_TYPE
# must be set together (true / servlet) or startup fails fast - see
# HttpTransportPropertiesValidator. DB2MCP_HTTP_BEARER_TOKEN is a single
# shared secret checked on every HTTP request, minimum 16 characters
# (startup fails fast if shorter); generate one with e.g.
# `openssl rand -hex 32`, never commit a real value.
DB2MCP_HTTP_ENABLED=
DB2MCP_HTTP_WEB_APPLICATION_TYPE=
DB2MCP_HTTP_BEARER_TOKEN=
