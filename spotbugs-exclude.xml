<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclude filter (issue #42, P1-5). Every entry below was added
  only after the finding it covers was investigated and confirmed to be
  either (a) an intentional, already-documented design decision, or (b) a
  well-known false-positive pattern for dependency-injected framework
  collaborators - never added preemptively. Findings against this
  project's own domain records (QueryResult/ProcedureDetail/ExplainPlanResult
  exposing mutable Lists) were genuinely fixed instead (List.copyOf in each
  record's compact constructor), not suppressed here - see those classes.
-->
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/4.9.7/spotbugs/etc/findbugsfilter.xsd">

    <!-- EI_EXPOSE_REP2: constructor stores a reference to an externally-
         mutable object directly, without a defensive copy. A well-known
         false-positive category for Spring dependency injection - each
         field below is a constructor-injected, singleton-scoped
         collaborator (a connection pool, a metrics registry, a JSON
         mapper, a stream this class's own job is to write to), not a
         value type a caller could meaningfully mutate out from under this
         class, and "defensively copying" a DataSource/OutputStream isn't
         possible in any way that preserves its purpose. -->
    <Match>
        <Class name="io.github.marekpompura.db2mcp.adapter.db2.Db2CapabilityAdapter" />
        <Field name="dataSource" />
        <Bug pattern="EI_EXPOSE_REP2" />
    </Match>
    <Match>
        <Class name="io.github.marekpompura.db2mcp.adapter.observability.MetricsRecorder" />
        <Field name="registry" />
        <Bug pattern="EI_EXPOSE_REP2" />
    </Match>
    <Match>
        <Class name="io.github.marekpompura.db2mcp.configuration.Db2ConnectivityChecker" />
        <Field name="dataSource" />
        <Bug pattern="EI_EXPOSE_REP2" />
    </Match>
    <Match>
        <Class name="io.github.marekpompura.db2mcp.configuration.SerializedStdioServerTransportProvider" />
        <Field name="jsonMapper" />
        <Bug pattern="EI_EXPOSE_REP2" />
    </Match>
    <Match>
        <Class name="io.github.marekpompura.db2mcp.configuration.SerializedStdioServerTransportProvider" />
        <Field name="outputStream" />
        <Bug pattern="EI_EXPOSE_REP2" />
    </Match>

    <!-- DM_EXIT: StdioLifecycleConfig's shutdown thread deliberately calls
         System.exit() - the entire point of ADR 0016's graceful-shutdown
         design is exiting the process when its MCP client disconnects,
         not something to avoid. -->
    <Match>
        <Class name="io.github.marekpompura.db2mcp.configuration.StdioLifecycleConfig" />
        <Bug pattern="DM_EXIT" />
    </Match>

    <!-- RV_RETURN_VALUE_IGNORED_NO_SIDE_EFFECT: SqlComplexityValidator's
         ComplexityWalker deliberately has empty visit(Values, S)/
         visit(TableStatement, S) overrides - see the explanatory comments
         directly above each in SqlComplexityValidator.java for why they
         genuinely have nothing to do (no join/nesting structure to walk),
         confirmed by inspection, not assumed safe to suppress. -->
    <Match>
        <Class name="io.github.marekpompura.db2mcp.policy.sql.SqlComplexityValidator$ComplexityWalker" />
        <Bug pattern="RV_RETURN_VALUE_IGNORED_NO_SIDE_EFFECT" />
    </Match>
</FindBugsFilter>
